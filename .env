# isi dengan nomor yang ingin anda jadikan bot, kode pairing muncul di log contoh, 6289848234234 < seperti ini contoh yah
PAIRING_NUMBER=

# nomor owner untuk penggunaan command khusus owner
OWNER=["6289681008411"]

#####################################################################################################
# Pengaturan Auto Restart
#####################################################################################################
# untuk size auto restart, RAM sisa 350MB auto restart
AUTO_RESTART=false
AUTO_RESTART_THRESHOLD=300MB

#####################################################################################################
# Pengaturan Mode
#####################################################################################################
# `true` untuk pribadi dan `false` untuk publik
SELF=true

#####################################################################################################
# Pengaturan Opsional
#####################################################################################################
# opsional
WRITE_STORE=false

# session name
SESSION_NAME=session

#####################################################################################################
# Pengaturan Sticker Pack
#####################################################################################################
# sticker pack
packName=Sticker Dibuat Oleh : 
packPublish=Wily Kun.

#####################################################################################################
# Pengaturan Backup Status ke Telegram
#####################################################################################################
# opsional jikalau perlu, untuk backup status ke telegram
# token bot telegram bisa diambil ke https://t.me/BotFather
# ambil id telegrammu di https://t.me/getmyid_bot
TELEGRAM_TOKEN=6580130814:AAHFTKpqwm8XC2QTJJ6Yfjp77Vh6ynciFe8
ID_TELEGRAM=5810736154

#####################################################################################################
# Pengaturan Fitur
#####################################################################################################

# Fitur Auto-Update
# Mengaktifkan atau menonaktifkan pembaruan otomatis
# true: Mengaktifkan pembaruan otomatis
# false: Menonaktifkan pembaruan otomatis
AUTO_UPDATE=true

# Fitur Auto Typing
# Mengaktifkan atau menonaktifkan fitur mengetik otomatis
# true: Mengaktifkan fitur mengetik otomatis
# false: Menonaktifkan fitur mengetik otomatis
ENABLE_TYPING=true

# Fitur Auto Recording
# Mengaktifkan atau menonaktifkan fitur merekam otomatis
# true: Mengaktifkan fitur merekam otomatis
# false: Menonaktifkan fitur merekam otomatis
ENABLE_RECORDING=false

# Fitur Menandai Pesan Sebagai Telah Diterima
# Mengaktifkan atau menonaktifkan fitur menandai pesan sebagai telah diterima
# true: Mengaktifkan fitur menandai pesan sebagai telah diterima
# false: Menonaktifkan fitur menandai pesan sebagai telah diterima
MARK_AS_RECEIVED=true

# Fitur Auto Bio
# Mengaktifkan atau menonaktifkan fitur bio otomatis
# true: Mengaktifkan fitur bio otomatis
# false: Menonaktifkan fitur bio otomatis
ENABLE_AUTO_BIO=true

# Fitur Reaksi Emoji
# Mengaktifkan atau menonaktifkan fitur reaksi emoji pada status
# true: Mengaktifkan fitur reaksi emoji
# false: Menonaktifkan fitur reaksi emoji
ENABLE_EMOJI_REACTION=true

# Fitur Self Mode
# Mengaktifkan atau menonaktifkan mode pribadi
# true: Mengaktifkan mode pribadi
# false: Menonaktifkan mode pribadi
SELF=true

# Fitur Write Store
# Mengaktifkan atau menonaktifkan penyimpanan data
# true: Mengaktifkan penyimpanan data
# false: Menonaktifkan penyimpanan data
WRITE_STORE=false

# Fitur Welcome
# Mengaktifkan atau menonaktifkan fitur welcome
# true: Mengaktifkan fitur welcome
# false: Menonaktifkan fitur welcome
ENABLE_WELCOME=true

# Fitur Goodbye
# Mengaktifkan atau menonaktifkan fitur goodbye
# true: Mengaktifkan fitur goodbye
# false: Menonaktifkan fitur goodbye
ENABLE_GOODBYE=true

# Fitur Name Change Notification
# Mengaktifkan atau menonaktifkan fitur notifikasi perubahan nama grup
# true: Mengaktifkan fitur notifikasi perubahan nama grup
# false: Menonaktifkan fitur notifikasi perubahan nama grup
ENABLE_NAME_CHANGE_NOTIFICATION=true

# Fitur Description Change Notification
# Mengaktifkan atau menonaktifkan fitur notifikasi perubahan deskripsi grup
# true: Mengaktifkan fitur notifikasi perubahan deskripsi grup
# false: Menonaktifkan fitur notifikasi perubahan deskripsi grup
ENABLE_DESCRIPTION_CHANGE_NOTIFICATION=true

# Fitur Permission Change Notification
# Mengaktifkan atau menonaktifkan fitur notifikasi perubahan izin grup
# true: Mengaktifkan fitur notifikasi perubahan izin grup
# false: Menonaktifkan fitur notifikasi perubahan izin grup
ENABLE_PERMISSION_CHANGE_NOTIFICATION=true

# Fitur Promotion/Demotion
# Mengaktifkan atau menonaktifkan fitur promosi dan demosi admin
# true: Mengaktifkan fitur promosi dan demosi admin
# false: Menonaktifkan fitur promosi dan demosi admin
ENABLE_PROMOTION_DEMOTION=true

# Hapus pengaturan fitur notifikasi perubahan pengaturan pesan sementara grup
# ENABLE_TEMPORARY_MESSAGE_CHANGE_NOTIFICATION=true
