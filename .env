# isi dengan nomor yang ingin anda jadikan bot, kode pairing muncul di log
PAIRING_NUMBER=

# nomor owner untuk penggunaan command khusus owner
OWNER=["6285815663170"]

#####################################################################################################
# Pengaturan Auto Restart
#####################################################################################################
# untuk size auto restart, RAM sisa 350MB auto restart
AUTO_RESTART=true
AUTO_RESTART_THRESHOLD=300MB

#####################################################################################################
# Pengaturan Mode
#####################################################################################################
# `true` untuk pribadi dan `false` untuk publik
SELF=true

#####################################################################################################
# Pengaturan Opsional
#####################################################################################################
# opsional
WRITE_STORE=false

# session name
SESSION_NAME=session

#####################################################################################################
# Pengaturan Sticker Pack
#####################################################################################################
# sticker pack
packName=Sticker Dibuat Oleh : 
packPublish=Dika Ardnt.

#####################################################################################################
# Pengaturan Backup Status ke Telegram
#####################################################################################################
# opsional jikalau perlu, untuk backup status ke telegram
# token bot telegram bisa diambile ke https://t.me/BotFather
# ambil id telegrammu di https://t.me/getmyid_bot
TELEGRAM_TOKEN=6580130814:AAHFTKpqwm8XC2QTJJ6Yfjp77Vh6ynciFe8
ID_TELEGRAM=5810736154

#####################################################################################################
# Pengaturan Fitur
#####################################################################################################
# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto-update
AUTO_UPDATE=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto typing
ENABLE_TYPING=false

# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto recording
ENABLE_RECORDING=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur menandai pesan sebagai telah diterima
MARK_AS_RECEIVED=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto bio
ENABLE_AUTO_BIO=true

